ALPACA_PAPER_TRADE=true
AFTERIMAGE_ALPACA_TRANSPORT=cli
AFTERIMAGE_ALPACA_CLI=.tools/bin/alpaca
AFTERIMAGE_ALPACA_CLI_SHA256=f8181e5e84b15f8846690cdbceda7e2c81e7929cf2bba52ef5b82b730e69400f
AFTERIMAGE_ALPACA_PROFILE=afterimage-paper
AFTERIMAGE_ACCOUNT_BINDING_PATH=.afterimage/alpaca-account.sha256
AFTERIMAGE_DB_URL=sqlite:///./.afterimage/afterimage.db
AFTERIMAGE_ACTIVE_STRATEGY=shadow_clock_shock_reversal_v1
AFTERIMAGE_SIGNING_KEY_PATH=.afterimage/warrant-ed25519.pem
AFTERIMAGE_ENABLE_PAPER_EXECUTION=false
# Required in addition to the switch for the HTTP execution endpoint.
AFTERIMAGE_EXECUTION_TOKEN=
# Required when serving the operator API on a non-loopback interface.
AFTERIMAGE_OPERATOR_TOKEN=
AFTERIMAGE_MAX_CACHED_SESSIONS=50
AFTERIMAGE_ALLOW_EXISTING_PAPER_EXPOSURE=false
# Optional fallback transport. Required only when AFTERIMAGE_ALPACA_TRANSPORT=mcp.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
AFTERIMAGE_ALPACA_MCP_PACKAGE=alpaca-mcp-server==2.3.1
AFTERIMAGE_UVX=uvx
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
AFTERIMAGE_DEEP_MODEL=zai-org/GLM-5.3
AFTERIMAGE_FAST_MODEL=zai-org/GLM-5.3-Flash
NEXT_PUBLIC_AFTERIMAGE_API=http://127.0.0.1:8000
